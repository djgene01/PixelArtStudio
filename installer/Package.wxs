<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Pixel Studio" Manufacturer="Eugene Bosman" Version="$(Version)"
           UpgradeCode="6B1D3F52-8E47-4C1A-9B5E-2F7A0D4C9E31" Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Pixel Studio is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Pixel Studio">
        <Files Include="$(PublishDir)\**">
          <Exclude Files="$(PublishDir)\PixelArtStudio.exe" />
          <Exclude Files="$(PublishDir)\**\*.pdb" />
        </Files>
        <Component Id="MainExecutable" Guid="*">
          <File Id="PixelArtStudioExe" Source="$(PublishDir)\PixelArtStudio.exe" KeyPath="yes" />
          <!-- Open .pxs projects with Pixel Studio. -->
          <ProgId Id="PixelArtStudio.Project" Description="Pixel Studio project" Icon="PixelArtStudioExe">
            <Extension Id="pxs" ContentType="application/x-pixelartstudio-project">
              <Verb Id="open" Command="Open" TargetFile="PixelArtStudioExe" Argument="&quot;%1&quot;" />
            </Extension>
          </ProgId>
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="AppShortcut" Name="Pixel Studio" Description="Pixel art and sprite animation editor"
                  Target="[#PixelArtStudioExe]" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\PixelArtStudio" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

  </Package>
</Wix>
