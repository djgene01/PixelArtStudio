<Window x:Class="PixelArtStudio.Dialogs.ResizeCanvasDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resize Canvas" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20" MinWidth="300">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Width (px)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="WidthBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Height (px)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="HeightBox" />
            </StackPanel>
        </Grid>
        <TextBlock Text="Anchor" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
        <UniformGrid x:Name="AnchorGrid" Rows="3" Columns="3" Width="132" Height="132" HorizontalAlignment="Left" />
        <TextBlock Text="Content stays at the anchor; the canvas grows or is cropped on the other sides."
                   Style="{StaticResource HintText}" TextWrapping="Wrap" MaxWidth="300" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Resize" IsDefault="True" Click="OnOk" MinWidth="88" Style="{StaticResource PrimaryButton}" />
            <Button Content="Cancel" IsCancel="True" MinWidth="88" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
