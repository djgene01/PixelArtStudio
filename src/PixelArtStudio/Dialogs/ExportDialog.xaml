<Window x:Class="PixelArtStudio.Dialogs.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20" Width="340">
        <TextBlock Text="Format" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="FormatBox" SelectionChanged="OnFormatChanged" />
        <TextBlock x:Name="FormatHint" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0" />

        <TextBlock Text="Scale" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
        <ComboBox x:Name="ScaleBox" />

        <Grid x:Name="RangePanel" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="From frame" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="FromBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="To frame" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="ToBox" />
            </StackPanel>
        </Grid>

        <StackPanel x:Name="SheetPanel" Margin="0,12,0,0">
            <TextBlock Text="Columns (0 = one row)" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="ColumnsBox" Text="0" />
            <CheckBox x:Name="JsonBox" Content="Write JSON with frame rectangles and durations" Margin="0,8,0,0" />
        </StackPanel>

        <CheckBox x:Name="LoopBox" Content="Loop forever" IsChecked="True" Margin="0,12,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Export..." IsDefault="True" Click="OnOk" MinWidth="88" Style="{StaticResource PrimaryButton}" />
            <Button Content="Cancel" IsCancel="True" MinWidth="88" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
