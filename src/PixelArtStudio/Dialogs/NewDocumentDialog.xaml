<Window x:Class="PixelArtStudio.Dialogs.NewDocumentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Sprite" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20" MinWidth="280">
        <TextBlock Text="Preset" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="PresetBox" SelectionChanged="OnPresetChanged" Margin="0,0,0,12">
            <ComboBoxItem Content="16 x 16" Tag="16" />
            <ComboBoxItem Content="32 x 32" Tag="32" />
            <ComboBoxItem Content="48 x 48" Tag="48" />
            <ComboBoxItem Content="64 x 64" Tag="64" />
            <ComboBoxItem Content="128 x 128" Tag="128" />
            <ComboBoxItem Content="256 x 256" Tag="256" />
        </ComboBox>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Width (px)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="WidthBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Height (px)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="HeightBox" />
            </StackPanel>
        </Grid>
        <TextBlock Text="1 to 1024 pixels per side." Style="{StaticResource HintText}" Margin="0,6,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Create" IsDefault="True" Click="OnOk" MinWidth="88" Style="{StaticResource PrimaryButton}" />
            <Button Content="Cancel" IsCancel="True" MinWidth="88" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
