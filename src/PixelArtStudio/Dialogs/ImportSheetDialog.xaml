<Window x:Class="PixelArtStudio.Dialogs.ImportSheetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Sprite Sheet" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20" MinWidth="300">
        <TextBlock x:Name="SheetInfo" Style="{StaticResource HintText}" Margin="0,0,0,12" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Frame width (px)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="WidthBox" TextChanged="OnSizeChanged" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Frame height (px)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="HeightBox" TextChanged="OnSizeChanged" />
            </StackPanel>
        </Grid>
        <TextBlock Text="Frame duration (ms)" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
        <TextBox x:Name="DurationBox" Text="100" />
        <CheckBox x:Name="SkipEmptyBox" Content="Skip empty cells" IsChecked="True" Margin="0,12,0,0" />
        <TextBlock x:Name="GridInfo" Style="{StaticResource HintText}" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Import" IsDefault="True" Click="OnOk" MinWidth="88" Style="{StaticResource PrimaryButton}" />
            <Button Content="Cancel" IsCancel="True" MinWidth="88" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
