<Window x:Class="PixelArtStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PixelArtStudio"
        xmlns:controls="clr-namespace:PixelArtStudio.Controls"
        xmlns:vm="clr-namespace:PixelArtStudio.ViewModels"
        Title="{Binding Title}" Width="1440" Height="920" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" Closing="OnClosing"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <local:EnumEqualsConverter x:Key="EnumEq" />
        <local:BoolToVisibleConverter x:Key="BoolToVisible" />

        <!--
            A colour square over a checkerboard, so transparency is visible. The data context is a SwatchViewModel:
            selected swatches get an accent frame, and swatches in a colour cycle a small corner marker.
        -->
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,0,3,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Frame" Background="{StaticResource SwatchChecker}"
                                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                                <Border Background="{TemplateBinding Background}" />
                            </Border>
                            <Border x:Name="CycleMark" Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,2,2" Background="White" BorderBrush="Black" BorderThickness="1" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="White" />
                            </Trigger>
                            <DataTrigger Binding="{Binding InCycle}" Value="True">
                                <Setter TargetName="CycleMark" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource ActiveFrameBorder}" />
                                <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New..." Command="{Binding NewCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="_Open..." Command="{Binding OpenCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="Open _Recent" ItemsSource="{Binding RecentFilePaths}" Click="OnRecentClick">
                    <MenuItem.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" />
                        </DataTemplate>
                    </MenuItem.ItemTemplate>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="Save _As..." Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="_Import Sprite Sheet..." Command="{Binding ImportSheetCommand}" />
                <MenuItem Header="_Export..." Command="{Binding ExportCommand}" InputGestureText="Ctrl+E" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" />
                <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="Cu_t" Command="{Binding CutCommand}" InputGestureText="Ctrl+X" />
                <MenuItem Header="_Copy" Command="{Binding CopyCommand}" InputGestureText="Ctrl+C" />
                <MenuItem Header="_Paste" Command="{Binding PasteCommand}" InputGestureText="Ctrl+V" />
                <MenuItem Header="_Delete" Command="{Binding DeleteSelectionCommand}" InputGestureText="Del" />
                <Separator />
                <MenuItem Header="Select _All" Command="{Binding SelectAllCommand}" InputGestureText="Ctrl+A" />
                <MenuItem Header="Dese_lect" Command="{Binding DeselectCommand}" InputGestureText="Ctrl+D" />
            </MenuItem>
            <MenuItem Header="_Image">
                <MenuItem Header="_Resize Canvas..." Command="{Binding ResizeCanvasCommand}" />
                <Separator />
                <MenuItem Header="Flip _Horizontal" Command="{Binding FlipHorizontalCommand}" />
                <MenuItem Header="Flip _Vertical" Command="{Binding FlipVerticalCommand}" />
                <MenuItem Header="Rotate 90° _Right" Command="{Binding RotateClockwiseCommand}" />
                <MenuItem Header="Rotate 90° _Left" Command="{Binding RotateCounterClockwiseCommand}" />
            </MenuItem>
            <MenuItem Header="_Layer">
                <MenuItem Header="_New Layer" Command="{Binding AddLayerCommand}" />
                <MenuItem Header="_Duplicate Layer" Command="{Binding DuplicateLayerCommand}" />
                <MenuItem Header="De_lete Layer" Command="{Binding DeleteLayerCommand}" />
                <Separator />
                <MenuItem Header="Move _Up" Command="{Binding MoveLayerUpCommand}" />
                <MenuItem Header="Move Do_wn" Command="{Binding MoveLayerDownCommand}" />
                <MenuItem Header="_Merge Down" Command="{Binding MergeDownCommand}" />
            </MenuItem>
            <MenuItem Header="F_rame">
                <MenuItem Header="_New Frame" Command="{Binding AddFrameCommand}" />
                <MenuItem Header="_Duplicate Frame" Command="{Binding DuplicateFrameCommand}" />
                <MenuItem Header="De_lete Frame" Command="{Binding DeleteFrameCommand}" />
                <Separator />
                <MenuItem Header="_Previous Frame" Command="{Binding PreviousFrameCommand}" InputGestureText="," />
                <MenuItem Header="Ne_xt Frame" Command="{Binding NextFrameCommand}" InputGestureText="." />
                <MenuItem Header="P_lay / Pause" Command="{Binding TogglePlayCommand}" InputGestureText="P, F5" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom _In" Command="{Binding ZoomInCommand}" InputGestureText="Ctrl++" />
                <MenuItem Header="Zoom _Out" Command="{Binding ZoomOutCommand}" InputGestureText="Ctrl+-" />
                <MenuItem Header="_Fit" Command="{Binding ZoomFitCommand}" InputGestureText="Ctrl+0" />
                <MenuItem Header="_Actual Size" Command="{Binding ZoomActualCommand}" InputGestureText="Ctrl+1" />
                <Separator />
                <MenuItem Header="Pixel _Grid" IsCheckable="True" IsChecked="{Binding ShowGrid}" InputGestureText="Ctrl+G" />
                <MenuItem Header="_Tile Grid">
                    <MenuItem Header="_Off" Command="{Binding SetTileGridCommand}" CommandParameter="0"
                              IsChecked="{Binding TileGridSize, Mode=OneWay, Converter={StaticResource EnumEq}, ConverterParameter=0}" />
                    <MenuItem Header="_8 x 8" Command="{Binding SetTileGridCommand}" CommandParameter="8"
                              IsChecked="{Binding TileGridSize, Mode=OneWay, Converter={StaticResource EnumEq}, ConverterParameter=8}" />
                    <MenuItem Header="_16 x 16" Command="{Binding SetTileGridCommand}" CommandParameter="16"
                              IsChecked="{Binding TileGridSize, Mode=OneWay, Converter={StaticResource EnumEq}, ConverterParameter=16}" />
                    <MenuItem Header="_32 x 32" Command="{Binding SetTileGridCommand}" CommandParameter="32"
                              IsChecked="{Binding TileGridSize, Mode=OneWay, Converter={StaticResource EnumEq}, ConverterParameter=32}" />
                </MenuItem>
                <MenuItem Header="_Onion Skin" IsCheckable="True" IsChecked="{Binding OnionSkin}" />
                <MenuItem Header="_Colour Cycling" IsCheckable="True" IsChecked="{Binding CyclePreview}" InputGestureText="F6" />
            </MenuItem>
        </Menu>

        <!-- Quick actions -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,1">
            <WrapPanel Margin="8,6,8,2">
                <Button Content="New" Command="{Binding NewCommand}" Style="{StaticResource SmallButton}" ToolTip="New sprite (Ctrl+N)" />
                <Button Content="Open" Command="{Binding OpenCommand}" Style="{StaticResource SmallButton}" ToolTip="Open a sprite or image (Ctrl+O)" />
                <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource SmallButton}" ToolTip="Save (Ctrl+S)" />
                <Button Content="Export" Command="{Binding ExportCommand}" Style="{StaticResource SmallButton}" ToolTip="Export PNG, GIF, APNG, WebP, sprite sheet (Ctrl+E)" Margin="0,0,16,4" />
                <Button Content="Undo" Command="{Binding UndoCommand}" Style="{StaticResource SmallButton}" ToolTip="Undo (Ctrl+Z)" />
                <Button Content="Redo" Command="{Binding RedoCommand}" Style="{StaticResource SmallButton}" ToolTip="Redo (Ctrl+Y)" Margin="0,0,16,4" />
                <Button Content="−" Command="{Binding ZoomOutCommand}" Style="{StaticResource SmallButton}" ToolTip="Zoom out (Ctrl+wheel)" />
                <TextBlock Text="{Binding ZoomText}" VerticalAlignment="Center" MinWidth="52" TextAlignment="Center" Margin="0,0,4,4" />
                <Button Content="+" Command="{Binding ZoomInCommand}" Style="{StaticResource SmallButton}" ToolTip="Zoom in (Ctrl+wheel)" />
                <Button Content="Fit" Command="{Binding ZoomFitCommand}" Style="{StaticResource SmallButton}" ToolTip="Fit to window (Ctrl+0)" />
                <Button Content="100%" Command="{Binding ZoomActualCommand}" Style="{StaticResource SmallButton}" ToolTip="Actual size (Ctrl+1)" Margin="0,0,16,4" />
                <ToggleButton Content="Grid" IsChecked="{Binding ShowGrid}" Style="{StaticResource SmallToggle}" ToolTip="Pixel grid, shown from 800% zoom (Ctrl+G)" />
                <ToggleButton Content="Onion skin" IsChecked="{Binding OnionSkin}" Style="{StaticResource SmallToggle}" ToolTip="Show the previous and next frames faintly" />
                <ToggleButton Content="Colour cycling" IsChecked="{Binding CyclePreview}" Style="{StaticResource SmallToggle}"
                              ToolTip="Animate the palette colour cycles on the canvas (F6)" />
            </WrapPanel>
        </Border>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Working..." Margin="0,0,16,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
                    <TextBlock Text="{Binding CursorText}" MinWidth="140" />
                    <TextBlock Text="{Binding SelectionText}" Margin="16,0,0,0" />
                    <TextBlock Text="{Binding SizeText}" Margin="16,0,0,0" />
                    <TextBlock Text="{Binding FrameText}" Margin="16,0,0,0" />
                    <TextBlock Text="{Binding ZoomText}" Margin="16,0,0,0" />
                    <TextBlock Text="{Binding McpStatus}" Margin="16,0,0,0" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Timeline -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0">
            <DockPanel Margin="8,6,8,6">
                <WrapPanel DockPanel.Dock="Top">
                    <TextBlock Text="Frames" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,4" />
                    <Button Content="Add" Command="{Binding AddFrameCommand}" Style="{StaticResource SmallButton}" ToolTip="Add an empty frame after this one" />
                    <Button Content="Duplicate" Command="{Binding DuplicateFrameCommand}" Style="{StaticResource SmallButton}" />
                    <Button Content="Delete" Command="{Binding DeleteFrameCommand}" Style="{StaticResource SmallButton}" />
                    <Button Content="◀" Command="{Binding MoveFrameLeftCommand}" Style="{StaticResource SmallButton}" ToolTip="Move frame left" />
                    <Button Content="▶" Command="{Binding MoveFrameRightCommand}" Style="{StaticResource SmallButton}" ToolTip="Move frame right" Margin="0,0,16,4" />
                    <ToggleButton Content="Play" IsChecked="{Binding IsPlaying, Mode=OneWay}" Command="{Binding TogglePlayCommand}"
                                  Style="{StaticResource SmallToggle}" ToolTip="Play or pause the animation on the canvas (P or F5)" />
                    <ToggleButton Content="Onion skin" IsChecked="{Binding OnionSkin}" Style="{StaticResource SmallToggle}" Margin="0,0,16,4" />
                    <TextBlock Text="Duration" VerticalAlignment="Center" Margin="0,0,6,4" />
                    <TextBox Text="{Binding ActiveFrameDuration}" Width="64" Style="{StaticResource CompactTextBox}" Margin="0,0,4,4"
                             ToolTip="How long this frame is shown, in milliseconds" />
                    <TextBlock Text="ms" VerticalAlignment="Center" Margin="0,0,16,4" />
                    <TextBlock Text="FPS" VerticalAlignment="Center" Margin="0,0,6,4" />
                    <TextBox Text="{Binding FpsText}" Width="48" Style="{StaticResource CompactTextBox}" Margin="0,0,4,4" />
                    <Button Content="Apply to all" Command="{Binding SetAllFpsCommand}" Style="{StaticResource SmallButton}"
                            ToolTip="Set every frame's duration from this frame rate" />
                </WrapPanel>
                <ListBox x:Name="FramesList" ItemsSource="{Binding Frames}" SelectedIndex="{Binding ActiveFrameIndex}"
                         Height="112" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FrameViewModel}">
                            <StackPanel>
                                <Border x:Name="ThumbFrame" BorderThickness="2" BorderBrush="Transparent">
                                    <Border Width="64" Height="64" Background="{StaticResource SwatchChecker}">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>
                                </Border>
                                <TextBlock HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="11">
                                    <Run Text="{Binding Number, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DurationMs, Mode=OneWay}" /><Run Text="ms" />
                                </TextBlock>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="ThumbFrame" Property="BorderBrush" Value="{StaticResource ActiveFrameBorder}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Tools -->
        <Border DockPanel.Dock="Left" Width="132" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <TextBlock Text="Tools" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                    <RadioButton Style="{StaticResource ToolButton}" Content="Pencil" ToolTip="Pencil (B). Left: primary colour, right: secondary."
                                 IsChecked="{Binding CurrentTool, Converter={StaticResource EnumEq}, ConverterParameter=Pencil}" />
                    <RadioButton Style="{StaticResource ToolButton}" Content="Eraser" ToolTip="Eraser (E)"
                                 IsChecked="{Binding CurrentTool, Converter={StaticResource EnumEq}, ConverterParameter=Eraser}" />
                    <RadioButton Style="{StaticResource ToolButton}" Content="Fill" ToolTip="Fill bucket (G)"
                                 IsChecked="{Binding CurrentTool, Converter={StaticResource EnumEq}, ConverterParameter=Fill}" />
                    <RadioButton Style="{StaticResource ToolButton}" Content="Eyedropper" ToolTip="Pick a colour (I). Left: primary, right: secondary."
                                 IsChecked="{Binding CurrentTool, Converter={StaticResource EnumEq}, ConverterParameter=Eyedropper}" />
                    <RadioButton Style="{StaticResource ToolButton}" Content="Line" ToolTip="Line (L). Hold Shift for 45° steps."
                                 IsChecked="{Binding CurrentTool, Converter={StaticResource EnumEq}, ConverterParameter=Line}" />
                    <RadioButton Style="{StaticResource ToolButton}" Content="Rectangle" ToolTip="Rectangle (U). Hold Shift for a square."
                                 IsChecked="{Binding CurrentTool, Converter={StaticResource EnumEq}, ConverterParameter=Rectangle}" />
                    <RadioButton Style="{StaticResource ToolButton}" Content="Ellipse" ToolTip="Ellipse (O). Hold Shift for a circle."
                                 IsChecked="{Binding CurrentTool, Converter={StaticResource EnumEq}, ConverterParameter=Ellipse}" />
                    <RadioButton Style="{StaticResource ToolButton}" Content="Select" ToolTip="Rectangle select (M). Drag inside to move; Del clears."
                                 IsChecked="{Binding CurrentTool, Converter={StaticResource EnumEq}, ConverterParameter=Select}" />

                    <TextBlock Style="{StaticResource SectionHeader}">
                        <Run Text="Brush size: " /><Run Text="{Binding BrushSize, Mode=OneWay}" />
                    </TextBlock>
                    <Slider Minimum="1" Maximum="64" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding BrushSize}"
                            ToolTip="Brush size ([ and ])" />

                    <TextBlock Text="Options" Style="{StaticResource SectionHeader}" />
                    <CheckBox Content="Mirror X" IsChecked="{Binding MirrorX}" ToolTip="Mirror strokes across the vertical centre line" />
                    <CheckBox Content="Mirror Y" IsChecked="{Binding MirrorY}" ToolTip="Mirror strokes across the horizontal centre line" />
                    <CheckBox Content="Fill shapes" IsChecked="{Binding ShapeFilled}" ToolTip="Rectangle and ellipse draw filled" />
                    <CheckBox Content="Contiguous" IsChecked="{Binding FillContiguous}" ToolTip="Fill only the connected area; off replaces the colour everywhere" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Colour, palette, layers, preview -->
        <Border DockPanel.Dock="Right" Width="300" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12,8,12,12">
                    <TextBlock Text="Colour" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid Width="64" Height="64" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Border Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Background="{StaticResource SwatchChecker}" BorderBrush="#FF888888" BorderThickness="1" ToolTip="Secondary colour (right mouse button)">
                                <Border Background="{Binding SecondaryBrush}" />
                            </Border>
                            <Border Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Background="{StaticResource SwatchChecker}" BorderBrush="White" BorderThickness="1" ToolTip="Primary colour (left mouse button)">
                                <Border Background="{Binding PrimaryBrush}" />
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Hex" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding PrimaryHex}" Style="{StaticResource CompactTextBox}" ToolTip="#RRGGBB or #RRGGBBAA" />
                            <Button Content="Swap (X)" Command="{Binding SwapColorsCommand}" Style="{StaticResource SmallButton}" Margin="0,6,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="R" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Maximum="255" Value="{Binding Red}" IsSnapToTickEnabled="True" TickFrequency="1" />
                        <TextBlock Grid.Column="2" Text="{Binding Red}" VerticalAlignment="Center" TextAlignment="Right" />
                        <TextBlock Grid.Row="1" Text="G" VerticalAlignment="Center" />
                        <Slider Grid.Row="1" Grid.Column="1" Maximum="255" Value="{Binding Green}" IsSnapToTickEnabled="True" TickFrequency="1" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Green}" VerticalAlignment="Center" TextAlignment="Right" />
                        <TextBlock Grid.Row="2" Text="B" VerticalAlignment="Center" />
                        <Slider Grid.Row="2" Grid.Column="1" Maximum="255" Value="{Binding Blue}" IsSnapToTickEnabled="True" TickFrequency="1" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Blue}" VerticalAlignment="Center" TextAlignment="Right" />
                        <TextBlock Grid.Row="3" Text="A" VerticalAlignment="Center" />
                        <Slider Grid.Row="3" Grid.Column="1" Maximum="255" Value="{Binding Alpha}" IsSnapToTickEnabled="True" TickFrequency="1" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Alpha}" VerticalAlignment="Center" TextAlignment="Right" />
                    </Grid>

                    <TextBlock Text="Palette" Style="{StaticResource SectionHeader}" />
                    <ItemsControl x:Name="PaletteItems" ItemsSource="{Binding PaletteColors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SwatchViewModel}">
                                <Button Style="{StaticResource SwatchButton}" Background="{Binding Brush}" ToolTip="{Binding ToolTip}"
                                        AutomationProperties.Name="{Binding Hex}"
                                        Command="{Binding DataContext.PickSwatchCommand, ElementName=PaletteItems}" CommandParameter="{Binding}">
                                    <Button.InputBindings>
                                        <MouseBinding Gesture="RightClick"
                                                      Command="{Binding DataContext.PickSwatchSecondaryCommand, ElementName=PaletteItems}"
                                                      CommandParameter="{Binding}" />
                                    </Button.InputBindings>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,4,0,0">
                        <Button Content="Add" Command="{Binding AddToPaletteCommand}" Style="{StaticResource SmallButton}" ToolTip="Add the primary colour" />
                        <Button Content="Remove" Command="{Binding RemoveFromPaletteCommand}" Style="{StaticResource SmallButton}" ToolTip="Remove the selected swatch" />
                        <Button Content="Replace" Command="{Binding ReplaceSwatchCommand}" Style="{StaticResource SmallButton}"
                                ToolTip="Set the selected swatch to the primary colour (a palette swap)" />
                        <Button Content="◀" Command="{Binding MoveSwatchLeftCommand}" Style="{StaticResource SmallButton}" ToolTip="Move the selected swatch left" />
                        <Button Content="▶" Command="{Binding MoveSwatchRightCommand}" Style="{StaticResource SmallButton}" ToolTip="Move the selected swatch right" />
                        <Button Content="Load" Command="{Binding LoadPaletteCommand}" Style="{StaticResource SmallButton}" ToolTip="Load a .hex or .gpl palette" />
                        <Button Content="Save" Command="{Binding SavePaletteCommand}" Style="{StaticResource SmallButton}" ToolTip="Save as .hex or .gpl" />
                        <Button Content="Reset" Command="{Binding ResetPaletteCommand}" Style="{StaticResource SmallButton}" ToolTip="PICO-8 + DawnBringer 32" />
                    </WrapPanel>
                    <CheckBox Content="Recolour pixels" IsChecked="{Binding RecolourPixels}" Margin="0,2,0,0"
                              ToolTip="Replace also changes every pixel of the old colour, in all frames and layers" />

                    <TextBlock Text="Colour cycles" Style="{StaticResource SectionHeader}" />
                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="Shift+click swatches to select a range, then add a cycle. Pixels painted in those exact colours rotate through the range." />
                    <ListBox ItemsSource="{Binding Cycles}" SelectedItem="{Binding SelectedCycle}" MaxHeight="200"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <EventSetter Event="GotKeyboardFocus" Handler="OnLayerItemFocus" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CycleViewModel}">
                                <StackPanel>
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Enabled}" ToolTip="Enabled" MinWidth="0" VerticalAlignment="Center" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding RangeText}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource DimText}" FontSize="11" />
                                        <TextBox Text="{Binding Name}" Background="Transparent" BorderThickness="0" MinHeight="0" Padding="2"
                                                 VerticalAlignment="Center" ToolTip="Click to rename" />
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" Margin="28,2,0,2">
                                        <TextBlock Text="Step" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource DimText}" />
                                        <TextBox Text="{Binding StepMs}" Width="56" Style="{StaticResource CompactTextBox}"
                                                 ToolTip="Milliseconds per step, 20 to 10000" />
                                        <TextBlock Text="ms" VerticalAlignment="Center" Margin="4,0,12,0" Foreground="{StaticResource DimText}" />
                                        <CheckBox Content="Reverse" IsChecked="{Binding Reverse}" MinWidth="0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="Add from selection" Command="{Binding AddCycleFromSelectionCommand}" Style="{StaticResource SmallButton}"
                                ToolTip="Add a colour cycle over the selected swatches" />
                        <Button Content="Delete" Command="{Binding DeleteCycleCommand}" Style="{StaticResource SmallButton}" ToolTip="Delete the selected cycle" />
                        <ToggleButton Content="Play cycles" IsChecked="{Binding CyclePreview}" Style="{StaticResource SmallToggle}"
                                      ToolTip="Animate the colour cycles on the canvas (F6)" />
                    </WrapPanel>

                    <TextBlock Text="Layers" Style="{StaticResource SectionHeader}" />
                    <ListBox ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}" MaxHeight="220"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <EventSetter Event="GotKeyboardFocus" Handler="OnLayerItemFocus" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LayerViewModel}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Visible}" ToolTip="Visible" MinWidth="0" VerticalAlignment="Center" />
                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource DimText}" FontSize="11">
                                        <Run Text="{Binding OpacityPercent, Mode=OneWay}" /><Run Text="%" />
                                    </TextBlock>
                                    <TextBox Text="{Binding Name}" Background="Transparent" BorderThickness="0" MinHeight="0" Padding="2"
                                             VerticalAlignment="Center" ToolTip="Click to rename" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="Add" Command="{Binding AddLayerCommand}" Style="{StaticResource SmallButton}" />
                        <Button Content="Duplicate" Command="{Binding DuplicateLayerCommand}" Style="{StaticResource SmallButton}" />
                        <Button Content="Delete" Command="{Binding DeleteLayerCommand}" Style="{StaticResource SmallButton}" />
                        <Button Content="▲" Command="{Binding MoveLayerUpCommand}" Style="{StaticResource SmallButton}" ToolTip="Move layer up" />
                        <Button Content="▼" Command="{Binding MoveLayerDownCommand}" Style="{StaticResource SmallButton}" ToolTip="Move layer down" />
                        <Button Content="Merge down" Command="{Binding MergeDownCommand}" Style="{StaticResource SmallButton}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,6,0,2">
                        <Run Text="Opacity: " /><Run Text="{Binding ActiveLayerOpacity, Mode=OneWay}" /><Run Text="%" />
                    </TextBlock>
                    <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ActiveLayerOpacity}" />

                    <TextBlock Text="Preview" Style="{StaticResource SectionHeader}" />
                    <Border Width="160" Height="160" HorizontalAlignment="Left" Background="{StaticResource SwatchChecker}"
                            BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Canvas -->
        <ScrollViewer x:Name="CanvasScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="{StaticResource WorkspaceBackground}" PreviewMouseWheel="OnCanvasWheel" Focusable="False"
                      SizeChanged="OnCanvasScrollerSizeChanged">
            <Grid Margin="48" HorizontalAlignment="Center" VerticalAlignment="Center">
                <controls:PixelCanvas x:Name="PixelView" Zoom="{Binding Zoom}" ShowGrid="{Binding ShowGrid}" TileGridSize="{Binding TileGridSize}" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
