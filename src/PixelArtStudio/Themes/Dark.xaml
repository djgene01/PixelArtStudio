<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- App colours on top of the Fluent dark theme. -->
    <SolidColorBrush x:Key="PanelBackground" Color="#FF202020" />
    <SolidColorBrush x:Key="WorkspaceBackground" Color="#FF161616" />
    <SolidColorBrush x:Key="PanelBorder" Color="#FF333333" />
    <SolidColorBrush x:Key="DimText" Color="#FFA0A0A0" />
    <SolidColorBrush x:Key="AccentFill" Color="#FF3B82F6" />
    <SolidColorBrush x:Key="ActiveFrameBorder" Color="#FF60A5FA" />

    <!-- Small checkerboard behind colour swatches and previews. -->
    <DrawingBrush x:Key="SwatchChecker" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FF5A5A5A" Geometry="M0,0 H8 V8 H0 Z" />
                <GeometryDrawing Brush="#FF464646" Geometry="M0,0 H4 V4 H0 Z M4,4 H8 V8 H4 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource DimText}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource DimText}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,14,0,6" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentFill}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Compact buttons for panels and the timeline. -->
    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="0,0,4,4" />
    </Style>

    <Style x:Key="SmallToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="0,0,4,4" />
    </Style>

    <!-- Tool strip: radio buttons drawn as toggle buttons. -->
    <Style x:Key="ToolButton" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="GroupName" Value="Tools" />
    </Style>

    <Style x:Key="CompactTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="6,3" />
    </Style>
</ResourceDictionary>
